# HorizonX app-host agent — systemd unit.
# Install on each app host:  sudo cp horizonx-agent.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now horizonx-agent
#
# The agent needs a working docker CLI + compose (it runs `docker compose` in
# /var/lib/horizonx/apps/<app>). The agent env (HORIZONX_SERVER_ID,
# HORIZONX_SERVER_API_TOKEN, HORIZONX_API_URL, HORIZONX_WS_URL, REDIS_ADDR)
# lives in /etc/horizonx/agent.env on the app host — `install agent` writes it
# there (NOT /etc/horizonx/.env, which is the server instance's env file).

[Unit]
Description=HorizonX app-host agent
Documentation=https://github.com/zlnew/horizonx
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=horizonx
Group=horizonx
WorkingDirectory=/var/lib/horizonx/apps
EnvironmentFile=/etc/horizonx/agent.env
ExecStart=/usr/local/bin/horizonx agent
Restart=always
RestartSec=5
# The agent shells out to docker/git — keep it a normal user in the docker group.
SupplementaryGroups=docker
# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
# Only the apps workdir is writable. /etc/horizonx is deliberately NOT here:
# it holds agent.env (this agent's API token) and, on single-box installs, the
# server's .env (DATABASE_URL, JWT_SECRET, the encryption key). The agent only
# reads its env at start — the installer writes it under sudo — so granting
# write access would let a compromised agent rewrite its own credentials, or
# the server's.
ReadWritePaths=/var/lib/horizonx

[Install]
WantedBy=multi-user.target
