# HorizonX control-plane server — systemd unit.
# Install:  sudo cp horizonx-server.service /etc/systemd/system/
#           sudo systemctl daemon-reload && sudo systemctl enable --now horizonx-server
#
# Environment lives in /etc/horizonx/.env (generated by `horizonx setup`).

[Unit]
Description=HorizonX control-plane server
Documentation=https://github.com/zlnew/horizonx
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=horizonx
Group=horizonx
WorkingDirectory=/etc/horizonx
EnvironmentFile=/etc/horizonx/.env
ExecStart=/usr/local/bin/horizonx server
Restart=on-failure
RestartSec=5
# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/horizonx /etc/horizonx
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
