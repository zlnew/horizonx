# ========================
# GLOBAL CONFIGURATION
# ========================

APP_ENV="development"
LOG_LEVEL="info"
LOG_FORMAT="text"

# ========================
# SERVER CONFIGURATION
# ========================

TIME_ZONE="Local"
HTTP_ADDR=":4858"
ALLOWED_ORIGINS="http://127.0.0.1:4859,http://localhost:4859"

# TRUST_PROXY trusts the first X-Forwarded-For header for login rate limiting
# and session-IP capture. Correct behind tailscale serve or another trusted
# reverse proxy; set to false if the API port is reachable directly. The server
# warns at startup when this is true and HTTP_ADDR is not a loopback address.
TRUST_PROXY="true"

DATABASE_URL="postgres://postgres:postgres@localhost:5432/horizonx?sslmode=disable"

JWT_SECRET="secret"
JWT_EXPIRY="24h"

# AES-256-GCM key for environment-variable values at rest. Setting it decouples
# secret encryption from JWT_SECRET, which otherwise orphans every stored env
# secret when rotated. Unset keeps the legacy behaviour (key derived from
# JWT_SECRET) and the server warns about it at startup. When first set, existing
# rows stay readable through the old JWT-derived key and are re-encrypted as
# they are read. NOTE: rotating this value after it is in use is NOT supported
# yet — there is no key ring, so keep it backed up and stable.
ENV_ENCRYPTION_KEY=""

ADMIN_EMAIL=admin@horizonx.local
ADMIN_PASSWORD=password

REDIS_ADDR="localhost:6379"
REDIS_USERNAME=""
REDIS_PASSWORD=""
REDIS_DB="0"

# Retention TTLs in days for the jobs and logs tables. Both are purged daily
# at 02:00 by the retention worker.
JOB_RETENTION_DAYS="30"
LOG_RETENTION_DAYS="14"

# ========================
# AGENT CONFIGURATION
# ========================

HORIZONX_API_URL="http://localhost:4858"
HORIZONX_WS_URL="ws://localhost:4858/ws/agent"
HORIZONX_SERVER_API_TOKEN="hzx_secret"
HORIZONX_SERVER_ID="123"
AGENT_JOB_WORKER_COUNT="10"

# ==========================
# RELEASE VERIFICATION
# ==========================

# minisign public key used to verify the SHA256SUMS signature on release
# downloads. Paste the bare base64 key line (the last line of a .pub file); a
# whole .pub file works too. Unset keeps checksum-only trust, as before; set
# makes the signature required, and a missing or bad one aborts the
# install/upgrade instead of silently continuing.
HORIZONX_RELEASE_PUBKEY=""

# ==========================
# ARTIFACT SOURCES
# ==========================

# Base URL release artifacts are fetched from (the server tarball and its
# SHA256SUMS). Point it at an internal mirror or artifact proxy when GitHub is
# unreachable or rate-limited. Unset uses https://github.com/zlnew/horizonx.
HX_ARTIFACT_BASE=""

# Local directory holding the dashboard image tarball plus its SHA256SUMS (and
# SHA256SUMS.minisig when HORIZONX_RELEASE_PUBKEY is set). Consulted before the
# GitHub release API, so an install with the artifacts already on disk never
# contacts GitHub. Still verified: with a pinned key, a tampered tarball or a
# tampered checksum file fails closed.
HX_TARBALL_DIR=""
